// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "custom/cpu", "temperature", "memory", "custom/gpu", "disk", "battery"],
    "modules-center": ["custom/pomodoro"],
    "modules-right": ["custom/mpris-prev", "custom/mpris-now", "custom/mpris-next", "custom/cava", "pulseaudio#source", "pulseaudio", "backlight", "custom/notification", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
    },

    "custom/mpris-prev": {
        "exec": "st=$(playerctl status 2>/dev/null); { [ \"$st\" = Playing ] || [ \"$st\" = Paused ]; } && printf '%s' '󰒮'",
        "format": "{}",
        "hide-empty-text": true,
        "interval": 1,
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/mpris-now": {
        "exec": "~/.config/waybar/scripts/mpris-now.sh",
        "format": "{}",
        "hide-empty-text": true,
        "restart-interval": 5,
        "on-click": "playerctl play-pause",
        "exec-on-event": false,
        "tooltip": false
    },

    "custom/mpris-next": {
        "exec": "st=$(playerctl status 2>/dev/null); { [ \"$st\" = Playing ] || [ \"$st\" = Paused ]; } && printf '%s' '󰒭'",
        "format": "{}",
        "hide-empty-text": true,
        "interval": 1,
        "on-click": "playerctl next",
        "tooltip": false
    },

    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava-viz.sh",
        "format": "{}",
        "hide-empty-text": true,
        "restart-interval": 5,
        "tooltip": false
    },

    // Clock + pomodoro in one cell (waybar can't hide its built-in clock on
    // demand). Idle: the clock, left-click toggles the date as before.
    // Started from the right-click panel, it shows the countdown; left-click
    // then swaps in the full date and time, middle-click pauses. The tooltip
    // is always the calendar. The '∶' argument is
    // the clock separator burn-in.sh rotates.
    "custom/pomodoro": {
        "exec": "~/.config/waybar/scripts/pomodoro.sh status '∶'",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/pomodoro.sh view",
        "on-click-right": "~/.config/waybar/scripts/pomodoro-panel.py",
        "on-click-middle": "~/.config/waybar/scripts/pomodoro.sh pause",
        "on-scroll-up": "~/.config/waybar/scripts/pomodoro.sh adjust 1",
        "on-scroll-down": "~/.config/waybar/scripts/pomodoro.sh adjust -1",
        "tooltip": true
    },

    // Script instead of the built-in cpu module so the tooltip can include
    // the fans.
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "return-type": "json",
        "format": "󰘚 {}%",
        "interval": 1,
        "tooltip": true
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "on-click": "~/.config/waybar/scripts/gpu.sh next",
        "signal": 8,
        "return-type": "json",
        "format": "{icon} {text}",
        "format-icons": {
            "integrated": "󰌨",
            "dedicated": "󰾲"
        },
        "interval": 2,
        "tooltip": true
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"]
    },

    "memory": {
        "format": "󰍛 {used:.1f}G",
        "tooltip-format": "{used:.1f}G used of {total:.1f}G ({percentage}%)",
        "interval": 1
    },

    "disk": {
        "format": "󰋊 {free}",
        "tooltip-format": "{free} free of {total} ({percentage_free}%)",
        "path": "/"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        // Unplugged: battery level. Charging: charging-bolt level. On AC but
        // not charging (charge threshold / held): power plug. On AC and full:
        // battery with a check mark.
        // Click toggles the time (left on battery / to full while charging).
        // No format-charging/-discharging on purpose: a status format would
        // override format-alt and break the toggle.
        "format": "{icon} {capacity}%",
        "format-alt": "{icon} {capacity}% {time}",
        "format-not-charging": "{icon} {capacity}%",
        "format-plugged": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-unknown": "{icon} {capacity}%",
        "format-time": "{H}∶{M:02}",
        "tooltip-format":              "On battery · drawing {power:.1f} W · {capacity}%\n{time} left\nHealth {health}% · {cycles} cycles",
        "tooltip-format-charging":     "Charging at {power:.1f} W · {capacity}%\nFull in {time}\nHealth {health}% · {cycles} cycles",
        "tooltip-format-not-charging": "Plugged in · not charging · {capacity}%\nHealth {health}% · {cycles} cycles",
        "tooltip-format-plugged":      "Plugged in · not charging · {capacity}%\nHealth {health}% · {cycles} cycles",
        "tooltip-format-full":         "Plugged in · fully charged\nHealth {health}% · {cycles} cycles",
        "tooltip-format-unknown":      "Battery status unknown · {capacity}%\nHealth {health}% · {cycles} cycles",
        "format-icons": {
            "default":      ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging":     ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "not-charging": ["󰚥"],
            "plugged":      ["󰚥"],
            "full":         ["󱟢"],
            "unknown":      ["󰂑"]
        }
    },

    "backlight": {
        "device": "amdgpu_bl2",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol --tab=3",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "swayosd-client --input-volume raise",
        "on-scroll-down": "swayosd-client --input-volume lower",
        "tooltip-format": "Mic: {source_volume}%"
    },

    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Left click: notification panel\nRight click: toggle focus mode (DND)",
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "~/.config/sway/scripts/notify-osd.sh dnd-toggle",
        "escape": true
    },

    "tray": {
        "icon-size": 13,
        "spacing": 8
    }
}
